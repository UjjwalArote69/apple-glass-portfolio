# Contact form (Resend). Copy to .env for local dev, and add the same
# variables in Vercel: Project Settings > Environment Variables.

# API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Optional. Where messages are delivered (defaults to ujjwalarote69@gmail.com).
# With Resend's test sender this must be the email on your Resend account.
CONTACT_TO_EMAIL=ujjwalarote69@gmail.com

# Optional. Sender address. Leave unset to use Resend's test sender
# (onboarding@resend.dev); after verifying a domain use e.g. Portfolio <hello@yourdomain.com>
# CONTACT_FROM_EMAIL=
